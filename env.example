# =============================================================================
# Environment Configuration - Intelligent Book Management System
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real credentials to version control.
#
# REQUIRED: DATABASE_URL and SECRET_KEY must be set
# RECOMMENDED: OPENROUTER_API_KEY for AI features, REDIS_URL for caching
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - Application will not start without these
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://bookuser:your_password@localhost:5432/intelligent_books_db

# Secret key for JWT (MUST be at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_must_be_at_least_32_characters

# -----------------------------------------------------------------------------
# RECOMMENDED - For full AI functionality
# -----------------------------------------------------------------------------

# OpenRouter API key (https://openrouter.ai/)
# Without this, AI uses simple fallback mode
OPENROUTER_API_KEY=

# Model to use
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# -----------------------------------------------------------------------------
# RECOMMENDED - For caching
# -----------------------------------------------------------------------------

# Redis URL (without this, caching is disabled)
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# OPTIONAL - Have sensible defaults
# -----------------------------------------------------------------------------

# Security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM settings
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=30
LLM_RETRY_ATTEMPTS=2
LLM_MAX_TOKENS_SUMMARY=150
LLM_MAX_TOKENS_RECOMMENDATION=200

# Application
LOG_LEVEL=INFO
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# DOCKER - Only needed for Docker Compose
# -----------------------------------------------------------------------------

POSTGRES_USER=bookuser
POSTGRES_PASSWORD=your_password
POSTGRES_DB=intelligent_books_db
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

