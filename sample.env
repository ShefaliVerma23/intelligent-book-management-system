# =============================================================================
# Intelligent Book Management System - Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp sample.env .env
#
# REQUIRED variables have no default and MUST be set.
# RECOMMENDED variables have defaults but should be set for full functionality.
# OPTIONAL variables have sensible defaults.
#
# =============================================================================

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://bookuser:your_secure_password@localhost:5432/intelligent_books_db

# Secret key for JWT token signing (MUST be at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_must_be_at_least_32_chars

# =============================================================================
# RECOMMENDED - For full AI functionality
# =============================================================================

# OpenRouter API key for AI features (summaries, recommendations)
# Get yours at: https://openrouter.ai/
# Without this, AI features will use simple fallback mode
OPENROUTER_API_KEY=

# OpenRouter model to use
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# =============================================================================
# RECOMMENDED - For caching (improves performance)
# =============================================================================

# Redis connection string
# Without this, caching is disabled (app still works, just slower)
REDIS_URL=redis://localhost:6379/0

# Enable/disable caching (only effective if REDIS_URL is set)
CACHE_ENABLED=true

# =============================================================================
# OPTIONAL - Have sensible defaults
# =============================================================================

# JWT token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT algorithm
JWT_ALGORITHM=HS256

# LLM parameters
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=30
LLM_RETRY_ATTEMPTS=2
LLM_MAX_TOKENS_SUMMARY=150
LLM_MAX_TOKENS_RECOMMENDATION=200

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# CORS allowed hosts (comma-separated, or * for all)
ALLOWED_HOSTS=*

# =============================================================================
# DOCKER - Only needed for Docker Compose
# =============================================================================

# PostgreSQL credentials for Docker
POSTGRES_USER=bookuser
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=intelligent_books_db

# Port mappings
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
